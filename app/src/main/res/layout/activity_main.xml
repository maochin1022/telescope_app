<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <TextureView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3FFFFFF"
        android:visibility="gone"
        android:elevation="10dp" />

    <!-- Histogram View -->
    <com.example.telescopeapp.HistogramView
        android:id="@+id/histogram_view"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top Settings Menu (Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/top_menu_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/btn_toggle_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="九宮格"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_histogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直方圖"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDR"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="倒數"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_flip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="鏡像"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="聲控"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_raw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAW"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_super_hdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="超動態"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />

            <TextView
                android:id="@+id/btn_toggle_stab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="防手震"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="?selectableItemBackground" />
        </LinearLayout>
    </HorizontalScrollView>

    <ImageView
        android:id="@+id/focus_ring"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/focus_ring"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_expand_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/arrow_down_float"
        app:tint="#FFFFFF"
        android:background="?selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Countdown Text -->
    <TextView
        android:id="@+id/countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="120sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="10"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 九宮格輔助線 -->
    <FrameLayout
        android:id="@+id/grid_lines_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="3">
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/grid_box" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/grid_box" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/grid_box" />
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="3">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/grid_box" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/grid_box" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/grid_box" />
        </LinearLayout>
    </FrameLayout>

    <!-- Parameter Control Panel (Visible only when a parameter is selected in PRO mode) -->
    <LinearLayout
        android:id="@+id/parameter_control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#80000000"
        app:layout_constraintBottom_toTopOf="@+id/parameter_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Value Display (Clickable for Input) -->
        <TextView
            android:id="@+id/parameter_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            android:text="AUTO"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?selectableItemBackground" />

        <!-- Slider and +/- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btn_param_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="?selectableItemBackgroundBorderless" />

            <com.google.android.material.slider.Slider
                android:id="@+id/parameter_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:tickVisible="false"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#80FFFFFF" />

            <TextView
                android:id="@+id/btn_param_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="?selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Presets Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/preset_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Parameter Tabs (Visible only in Manual Mode) -->
    <HorizontalScrollView
        android:id="@+id/parameter_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/mode_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/parameter_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Mode Selector -->
    <LinearLayout
        android:id="@+id/mode_layout"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@+id/bottom_control_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/mode_auto"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="自動"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mode_manual"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="專業"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部控制區 (半透明) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_control_bar"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_control_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 動態鏡頭切換列 -->
        <HorizontalScrollView
            android:id="@+id/zoom_scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/zoom_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/image_capture_button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_shutter_button"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/zoom_scroll_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/thumbnail_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@id/image_capture_button"
            app:layout_constraintTop_toTopOf="@id/image_capture_button"
            app:layout_constraintEnd_toStartOf="@id/image_capture_button" />

        <ImageButton
            android:id="@+id/video_capture_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@android:drawable/presence_video_online"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@id/image_capture_button"
            app:layout_constraintTop_toTopOf="@id/image_capture_button"
            app:layout_constraintStart_toEndOf="@id/image_capture_button"
            app:layout_constraintEnd_toEndOf="parent" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
